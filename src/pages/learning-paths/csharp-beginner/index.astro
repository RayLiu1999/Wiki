---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Icon from '../../../components/Icon.astro';
import { getArticles, articleUrl, categories, levelLabel } from '../../../lib/catalog';
const articles = await getArticles();
---
<SiteLayout title="C# 入門學習路徑">
  <section class="page-intro">
    <p class="eyebrow"><Icon name="network" size={17} />推薦學習路徑</p>
    <h1>你的 C# 入門地圖。</h1><p>每次理解一個概念，不急著一次記住所有語法。<br />沿著五個階段，走過 {articles.length} 篇核心文章。</p>
    <div class="hero-actions"><a class="button-primary" href={articleUrl(articles[0])}>從第一篇開始<Icon name="arrow" size={18} /></a><span class="muted">適合第一次接觸 C# 的讀者</span></div>
  </section>
  <ol class="learning-path">{categories.map((category, index) => <li class="learning-step"><span class="step-number">{String(index + 1).padStart(2, '0')}</span><div class="step-content"><p class="eyebrow">{category.name}</p><h2>{category.step}</h2><p>{category.description}。</p><ol class="step-articles">{articles.filter((article) => article.data.category === category.id).map((article) => <li><a href={articleUrl(article)}><span>{article.data.title}</span><span class="step-level">{levelLabel(article.data.difficulty)}</span><Icon name="arrow" size={16} /></a></li>)}</ol></div></li>)}</ol>
  <p class="path-tip"><Icon name="info" size={18} />標示「進階」的文章可以先讀概念，熟悉基本語法後再回來練習。</p>
</SiteLayout>
