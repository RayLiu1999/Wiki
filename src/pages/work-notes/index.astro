---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import notes from '../../data/work-notes.json';
import { getArticles, articleUrl, topicFor } from '../../lib/catalog';
const articles = await getArticles();
const lookup = new Map(articles.map((article) => [article.data.articleId, article]));
const conceptCount = notes.groups.reduce((total, group) => total + group.items.length, 0);
---
<SiteLayout title="工作筆記概念對照" description="把每日筆記摘要依既有概念統整，回查日期、文章與容易誤記的觀念。">
  <section class="page-intro">
    <p class="eyebrow"><Icon name="book" size={17} />工作中的知識脈絡</p>
    <h1>讓零散的筆記，找到位置。</h1>
    <p>{notes.startDate} 至 {notes.endDate}，依你提供的 {notes.reportedNoteCount} 篇筆記摘要，統整成 {conceptCount} 個概念群組。</p>
    <p class="source-note">{notes.provenance}</p>
    <div class="hero-actions"><a class="button-primary" href="/learning-paths/dotnet-backend-practice/">依實務路徑閱讀<Icon name="arrow" size={17} /></a><a class="text-link" href="/topics/">瀏覽全部主題<Icon name="arrow" size={17} /></a></div>
  </section>
  <nav class="note-group-links" aria-label="筆記主題目錄">{notes.groups.map((group, index) => <a href={'#notes-' + index}>{group.title}</a>)}</nav>
  {notes.groups.map((group, index) => <section class="note-mapping-section" aria-labelledby={'notes-' + index}>
    <div class="section-heading"><h2 id={'notes-' + index}>{group.title}</h2><span class="result-count">{group.items.length} 組概念</span></div>
    <div class="note-mapping-list">{group.items.map((item) => <article class="note-mapping-item">
      <div><h3>{item.title}</h3><p>{item.concepts.join(' · ')}</p><p class="note-dates">筆記日期：{item.dates.map((date) => date.slice(5).replace('-', '/')).join('、')}</p></div>
      <ul>{item.articleIds.map((id) => { const article = lookup.get(id)!; return <li><a href={articleUrl(article)}><span><small>{topicFor(article.data.topic)!.name}</small><strong>{article.data.title}</strong></span><Icon name="arrow" size={16} /></a></li>; })}</ul>
    </article>)}</div>
  </section>)}
</SiteLayout>
