---
import MovedPage from '../../../components/MovedPage.astro';
// 「網路與協定」已併入「容器與網路」主題。
export function getStaticPaths() {
  const base = '/infrastructure/containers-networking/';
  return [
    { params: { slug: undefined }, props: { target: { title: '容器與網路', url: base } } },
    { params: { slug: 'request-path' }, props: { target: { title: '一筆請求的網路路徑', url: base + 'request-path/' } } },
  ];
}
---
<MovedPage target={Astro.props.target} reason="容器與網路已合併成同一個主題。" />
