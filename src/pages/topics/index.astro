---
import SiteLayout from '../../layouts/SiteLayout.astro';
import TopicCards from '../../components/TopicCards.astro';
import { getArticles } from '../../lib/catalog';
const articles = await getArticles();
---
<SiteLayout title="知識主題">
  <section class="page-intro"><p class="eyebrow">軟體知識地圖</p><h1>把工作中的概念，串成理解。</h1><p>{articles.length} 篇文章，從 C# 延伸到 Web API、架構、資料與系統診斷。</p></section>
  <TopicCards />
  <p class="path-tip"><a href="/work-notes/">查看工作筆記的主題與日期對照</a></p>
</SiteLayout>
