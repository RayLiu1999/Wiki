---
import Icon from './Icon.astro';
import ArticleRow from './ArticleRow.astro';
import { getArticles, topicFor, type Article } from '../lib/catalog';
import type { TopicId } from '../lib/taxonomy';
import { learningPathUrl } from '../lib/learning-paths';
interface Props { topicId: TopicId; }
const { topicId } = Astro.props;
const topic = topicFor(topicId)!;
const articles: Article[] = await getArticles(topicId);
const pathId = topicId === 'csharp' ? 'csharp-beginner'
  : topicId === 'data-access' ? 'dotnet-database-scale'
  : ['redis', 'rabbitmq'].includes(topicId) ? 'dotnet-cache-messaging'
  : ['containers', 'networking', 'kubernetes'].includes(topicId) ? 'cloud-native-foundations'
  : topicId === 'gke' ? 'gke-delivery-operations' : 'dotnet-backend-practice';
---
<section class="page-intro">
  <p class="eyebrow"><a href="/topics/">知識主題</a> / {topic.name}</p>
  <div class="topic-heading"><span class:list={['cs-mark', { 'wide-mark': topicId !== 'csharp' }]}>{topic.mark}</span><h1>{topic.name} 文章</h1></div>
  <p>{topic.description}</p>
  <div class="topic-meta"><span>{articles.length} 篇文章</span><span>·</span><span>{topic.categories.length} 個分類</span><span>·</span><a href={learningPathUrl(pathId)}>查看學習路徑 <Icon name="arrow" size={14} /></a></div>
</section>
<div class="category-filters" role="group" aria-label="文章分類">
  <button type="button" class="filter-button" data-filter="all" aria-pressed="true">全部文章</button>
  {topic.categories.map((category) => <button type="button" class="filter-button" data-filter={category.id} aria-pressed="false">{category.name}<span>{articles.filter((article) => article.data.category === category.id).length}</span></button>)}
</div>
<div class="section-heading"><h2 class="list-heading" data-filter-heading>全部文章</h2><span class="result-count" data-filter-count role="status">{articles.length} 篇</span></div>
<div class="article-list">{articles.map((article) => <ArticleRow article={article} showCategory />)}</div>
