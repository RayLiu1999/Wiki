---
import Icon from '../Icon.astro';
import { getArticles, articleUrl } from '../../lib/catalog';
const data = Astro.locals.starlightRoute.entry.data;
const allArticles = await getArticles();
const articles = allArticles.filter((article) => article.data.topic === data.topic);
const index = articles.findIndex((entry) => entry.data.articleId === data.articleId);
const previous = index > 0 ? articles[index - 1] : undefined;
const next = index >= 0 ? articles[index + 1] : undefined;
const prerequisites = allArticles.filter((entry) => data.prerequisites?.includes(entry.data.articleId));
const related = allArticles.filter((entry) => data.relatedArticles?.includes(entry.data.articleId));
---
<div class="article-resources">
  {data.noteDates.length > 0 && <section class="note-provenance"><h2>工作筆記脈絡</h2><p>對應使用者提供的每日筆記摘要：{data.noteDates.join('、')}。</p><p class="source-note">依摘要統整並補充官方文件；原始筆記與技術子頁未直接匯入。<a href="/work-notes/">查看主題與日期對照</a></p></section>}
  {prerequisites.length > 0 && <section><h2>建議先讀</h2><ul>{prerequisites.map((article) => <li><a href={articleUrl(article)}>{article.data.title}</a></li>)}</ul></section>}
  {related.length > 0 && <section><h2>連結相關知識</h2><ul>{related.map((article) => <li><a href={articleUrl(article)}>{article.data.title}</a></li>)}</ul></section>}
  <section id="references"><h2>參考來源</h2><ul>{data.sources?.map((source) => <li><a href={source.url} rel="noopener noreferrer">{source.title}</a></li>)}</ul><p class="source-note">外部來源需要網路連線。</p></section>
</div>
<nav class="article-pagination" aria-label="前後文章" data-pagefind-ignore>
  {previous ? <a href={articleUrl(previous)}><small>上一個概念</small><strong>{previous.data.title}</strong></a> : <span />}
  {next ? <a href={articleUrl(next)}><span><small>接著理解</small><strong>{next.data.title}</strong></span><Icon name="arrow" /></a> : <a href="/learning-paths/"><span><small>繼續連結概念</small><strong>選擇學習路徑</strong></span><Icon name="arrow" /></a>}
</nav>
