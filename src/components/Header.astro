---
import Icon from './Icon.astro';
import { getCatalog } from '../lib/catalog';
const path = Astro.url.pathname;
const links = [
  { href: '/', label: '探索', active: path === '/' },
  { href: '/languages/csharp/', label: 'C# 主題', active: path.startsWith('/languages/') },
  { href: '/learning-paths/csharp-beginner/', label: '學習路徑', active: path.startsWith('/learning-paths/') },
  { href: '/saved/', label: '收藏', active: path.startsWith('/saved/') },
];
const catalog = await getCatalog();
---
<header class="wiki-header" data-pagefind-ignore>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="DevWiki 首頁">
      <span class="brand-mark"><Icon name="layers" size={23} /></span>
      <span class="brand-name">DevWiki<small>軟體知識庫</small></span>
    </a>
    <nav class="primary-nav" aria-label="主要導覽">
      {links.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <div class="header-tools">
      <button class="search-trigger" type="button" data-search-open aria-label="搜尋文章">
        <Icon name="search" size={18} /><span>搜尋概念或關鍵字</span><kbd>⌘ K</kbd>
      </button>
      <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="切換至深色模式">
        <span class="moon-icon"><Icon name="moon" /></span><span class="sun-icon"><Icon name="sun" /></span>
      </button>
    </div>
  </div>
</header>
<dialog class="search-dialog" id="wiki-search" aria-labelledby="search-title">
  <div class="search-dialog-heading">
    <h2 id="search-title">搜尋知識庫</h2>
    <button class="icon-button" type="button" data-search-close aria-label="關閉搜尋"><Icon name="close" /></button>
  </div>
  <label class="search-input-label" for="search-input">概念、語法或關鍵字</label>
  <div class="search-input-wrap"><Icon name="search" /><input id="search-input" type="search" placeholder="試試「非同步」、「泛型」或 LINQ" autocomplete="off" /></div>
  <p class="search-status" id="search-status" role="status" aria-live="polite">輸入關鍵字，找到你想理解的概念。</p>
  <div class="search-results" id="search-results"></div>
  <div class="search-shortcuts"><span><kbd>Tab</kbd> 選擇結果</span><span><kbd>Esc</kbd> 關閉</span></div>
</dialog>
<script type="application/json" id="wiki-catalog" set:html={JSON.stringify(catalog).replace(/</g, '\\u003c')} />
<script>
  import '../scripts/site';
</script>
